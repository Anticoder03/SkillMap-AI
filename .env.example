# --- Core ---
# Django secret key. Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=generate-a-secret-key

# Set to False in production.
DEBUG=True

# Comma-separated list of allowed hosts. 'testserver' is required for the test suite.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# --- Database ---
# Leave DATABASE_NAME empty to use SQLite (zero-config).
# Set it to use PostgreSQL (psycopg3 must be installed).
DATABASE_NAME=
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# --- AI Provider ---
# One of: gemini, openai, nvidia, ollama
AI_PROVIDER=gemini

# API key for the selected remote provider (not needed for ollama).
AI_API_KEY=your_gemini_api_key

# Optional model override per provider. Defaults live in config/settings.py.
AI_MODEL=

# Seconds to wait for an AI response before failing over to the data layer.
AI_TIMEOUT_SECONDS=45

# --- Google Search (SerpAPI) ---
# Optional: used to find live Google results (with real snippets) as learning
# resources for roadmap tasks. Without a key, curated/AI resources are used.
SERPAPI_API_KEY=your_serpapi_key
# Optional search location (country/region context), e.g. "United States" or "India".
SERPAPI_LOCATION=
# Max number of Google searches per resource-refresh (protects rate limits).
SERPAPI_MAX_QUERIES=20
# How many organic results to fetch per search.
SERPAPI_RESULTS_NUM=5

# --- Recommendation engine ---
# How many top career matches to persist for each user.
RECOMMENDATION_LIMIT=5